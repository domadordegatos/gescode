# Dependencias (se regeneran con `composer install`)
/vendor/

# Datos sensibles / generados en runtime — nunca deben subirse al repo
# (se deja .gitkeep en cada carpeta para que la estructura exista tras un clone)
/storage/backups/*
/storage/firmas_autorizaciones/*
/storage/retiros_anticipados/*
/storage/comunidad/*
/storage/comunidad_papelera/*
/storage/carga_notas_tmp/*
/storage/adjuntos/*
/storage/avatars/*
/storage/tareas/*
/public/uploads/imagenes/*
!**/.gitkeep

# Variables de entorno / credenciales locales
.env
.env.local

# Archivos de sistema
.DS_Store
Thumbs.db

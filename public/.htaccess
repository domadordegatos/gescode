Options -Indexes
RewriteEngine On

# Bloquear acceso directo a archivos PHP salvo index.php y dbinstall.php
RewriteCond %{REQUEST_FILENAME} -f
RewriteCond %{REQUEST_URI} \.php$
RewriteCond %{REQUEST_URI} !^/index\.php$
RewriteCond %{REQUEST_URI} !^/dbinstall\.php$
RewriteRule ^ - [F]

# Redirigir todo al index.php excepto archivos estáticos
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [QSA,L]
